[
  {
    "$schema": "urn:quiet-ui:schema:v9:bitfield",
    "id": "bench-m3-l1-readiness-frame",
    "metadata": {
      "title": "Optical Transceiver Functional Readiness Frame",
      "description": "Orientation status summary synthesized from BAR0 optical control register flags without exposing bit manipulation.",
      "mnemonic": "CSR_OPTICAL_READY",
      "rigor_level": "L1",
      "register_width_bits": 32,
      "current_value": "0x8004A01C"
    },
    "fields": [
      {"name": "LASER_ENABLE", "bit_range": [31, 31], "access": "RW", "reset": 0, "current_value": 1, "description": "Master pump laser enabled."},
      {"name": "PLL_LOCK_STATUS", "bit_range": [30, 30], "access": "RO", "reset": 0, "current_value": 1, "description": "Clock synthesizer PLL locked."},
      {"name": "TX_FAULT_FLAG", "bit_range": [15, 15], "access": "W1C", "reset": 0, "current_value": 1, "description": "Over-current fault latch triggered."}
    ]
  },
  {
    "$schema": "urn:quiet-ui:schema:v9:bitfield",
    "id": "bench-m3-l2-ccsds-header",
    "metadata": {
      "title": "48-Bit CCSDS 133.0-B-2 Space Packet Primary Header",
      "description": "Governance 48-bit protocol header split across three 16-bit portrait-safe rows with byte/bit field boundaries.",
      "mnemonic": "CCSDS_PRIMARY_HDR",
      "rigor_level": "L2",
      "address_offset": "0x0000",
      "register_width_bits": 48,
      "reset_value": "0x000000000000",
      "current_value": "0x0842C01500FF"
    },
    "fields": [
      {"name": "VERSION", "short_name": "VER", "bit_range": [47, 45], "access": "RO", "reset": 0, "description": "Packet Version Number (000 = Version 1)."},
      {"name": "PKT_TYPE", "short_name": "TYP", "bit_range": [44, 44], "access": "RO", "reset": 0, "description": "0 = Telemetry (TM), 1 = Telecommand (TC)."},
      {"name": "SEC_HDR_FLAG", "short_name": "SHF", "bit_range": [43, 43], "access": "RO", "reset": 0, "description": "1 = Secondary Header present."},
      {"name": "APID", "short_name": "APID", "bit_range": [42, 32], "access": "RW", "reset": 0, "description": "Application Process Identifier (0x042 = Optical Timing)."},
      {"name": "SEQ_FLAGS", "short_name": "SEQ", "bit_range": [31, 30], "access": "RW", "reset": 0, "description": "11 = Unsegmented standalone packet."},
      {"name": "PKT_SEQ_COUNT", "short_name": "PKT_SEQ_CNT", "bit_range": [29, 16], "access": "RO", "reset": 0, "description": "Modulo-16384 packet sequence counter."},
      {"name": "PKT_DATA_LEN", "short_name": "DATA_LEN_MINUS_1", "bit_range": [15, 0], "access": "RW", "reset": 0, "description": "Total octets in Packet Data Field minus 1 (256 octets)."}
    ]
  },
  {
    "$schema": "urn:quiet-ui:schema:v9:bitfield",
    "id": "bench-m3-l3-1553b-and-mmio",
    "metadata": {
      "title": "16-Bit MIL-STD-1553B Status Word & 32-Bit BAR0 MMIO CSR",
      "description": "Physical bit-level truth pairing the 16-bit MIL-STD-1553B RT Status Word (0x1A01) with the 32-bit BAR0 Optical Control/Status Register (0x8004A01C).",
      "rigor_level": "L3"
    },
    "registers": [
      {
        "metadata": {
          "title": "MIL-STD-1553B RT-03 Status Word",
          "mnemonic": "MIL1553_RT_STATUS",
          "address_offset": "RT-03 SUBADDR-02",
          "register_width_bits": 16,
          "reset_value": "0x0000",
          "current_value": "0x1A01"
        },
        "fields": [
          {"name": "RT_ADDRESS", "short_name": "RT_ADDR", "bit_range": [15, 11], "access": "RO", "reset": 0, "description": "5-bit Remote Terminal bus address (0b00011 = RT-03)."},
          {"name": "MSG_ERR", "short_name": "ME", "bit_range": [10, 10], "access": "W1C", "reset": 0, "description": "Message Error bit. 1 = Manchester II or parity fault.", "safety_critical": true},
          {"name": "INSTRUMENT", "short_name": "INST", "bit_range": [9, 9], "access": "RO", "reset": 0, "description": "Instrumentation bit. 1 = Status word vs Command word."},
          {"name": "SVC_REQ", "short_name": "SRQ", "bit_range": [8, 8], "access": "RO", "reset": 0, "description": "Service Request flag to Bus Controller."},
          {"name": "RESERVED", "short_name": "RSVD", "bit_range": [7, 5], "access": "RO", "reset": 0, "description": "Reserved per MIL-STD-1553B; must transmit 0."},
          {"name": "BCAST_RCVD", "short_name": "BCST", "bit_range": [4, 4], "access": "RO", "reset": 0, "description": "Broadcast command received."},
          {"name": "BUSY_FLAG", "short_name": "BUSY", "bit_range": [3, 3], "access": "RO", "reset": 0, "description": "Terminal subsystem busy."},
          {"name": "SUBSYS_FLT", "short_name": "SF", "bit_range": [2, 2], "access": "RO", "reset": 0, "description": "Subsystem fault detected."},
          {"name": "DYN_BUS_CTL", "short_name": "DBC", "bit_range": [1, 1], "access": "RW", "reset": 0, "description": "Dynamic Bus Control acceptance."},
          {"name": "TERM_FLAG", "short_name": "TF", "bit_range": [0, 0], "access": "RO", "reset": 0, "description": "Terminal Fault indicator."}
        ]
      },
      {
        "metadata": {
          "title": "BAR0 Optical Transceiver CSR",
          "mnemonic": "CSR_OPTICAL_STATUS_CTRL",
          "address_offset": "0x0040",
          "register_width_bits": 32,
          "reset_value": "0x00000000",
          "current_value": "0x8004A01C"
        },
        "fields": [
          {"name": "LASER_ENABLE", "short_name": "EN", "bit_range": [31, 31], "access": "RW", "reset": 0, "description": "Master optical pump laser enable.", "safety_critical": true},
          {"name": "PLL_LOCK", "short_name": "LCK", "bit_range": [30, 30], "access": "RO", "reset": 0, "description": "Clock synthesizer PLL lock flag."},
          {"name": "PWR_MODE", "short_name": "PWR", "bit_range": [29, 28], "access": "RW", "reset": 0, "description": "Attenuation mode (00 = 0 dB, 11 = Mute)."},
          {"name": "CHANNEL_SEL", "short_name": "CH", "bit_range": [27, 24], "access": "RW", "reset": 0, "description": "DWDM ITU optical grid channel index."},
          {"name": "TEMP_WARN_LIMIT", "short_name": "TEMP_WARN", "bit_range": [23, 16], "access": "RW", "reset": 0, "description": "Thermal alarm threshold in 0.5 °C steps (0xA0 = 80 °C)."},
          {"name": "TX_FAULT", "short_name": "TXF", "bit_range": [15, 15], "access": "W1C", "reset": 0, "description": "Transmitter optical over-current fault. Write 1 to clear.", "safety_critical": true},
          {"name": "RX_LOS", "short_name": "LOS", "bit_range": [14, 14], "access": "RO", "reset": 0, "description": "Receiver Loss of Signal indicator."},
          {"name": "RESERVED", "short_name": "RSVD", "bit_range": [13, 8], "access": "RO", "reset": 0, "description": "Reserved; preserve as zero."},
          {"name": "BURST_ERR_CNT", "short_name": "BURST_ERR_CNT", "bit_range": [7, 0], "access": "RC", "reset": 0, "description": "Cumulative parity burst error counter (read-to-clear)."}
        ]
      }
    ]
  }
]
