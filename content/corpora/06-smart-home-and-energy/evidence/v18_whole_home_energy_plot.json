{
  "$schema": "urn:quiet-ui:schema:v9:plot",
  "id": "v18-whole-home-energy-plot",
  "plot_kind": "cartesian",
  "metadata": {
    "title": "24-Hour Residential Solar PV, Whole-Home Load & Net Grid Exchange",
    "description": "Discrete 2-hour interval metering (+/-u_y) across PV-STRING-SOUTH, PANEL-MAIN-200A, and utility net exchange showing -1.68 kW export at 14:00 ahead of the $0.34 / kWh peak TOU window.",
    "rigor_level": "L2",
    "timestamp_utc": "2026-11-18T14:00:00Z"
  },
  "test_environment": {
    "dut_id": "PANEL-MAIN-200A",
    "standard_id": "IEEE-2030.5 / ANSI C12.20",
    "ambient_temperature_c": 21.5,
    "temperature_uncertainty_c": 0.2,
    "peak_tou_window": "16:00-21:00 ($0.34 / kWh)"
  },
  "tariff_schedule": {
    "off_peak_usd_kwh": 0.14,
    "peak_evening_usd_kwh": 0.34,
    "peak_window_hours": [16, 21]
  },
  "axes": {
    "x_axis": {
      "quantity": "t_hr",
      "unit": "h",
      "quantity_calculus": "Local Solar Time, t / h",
      "scale_type": "linear",
      "domain": [0.0, 24.0]
    },
    "y_axis": {
      "quantity": "P",
      "unit": "kW",
      "quantity_calculus": "Active Electrical Power, P / kW",
      "scale_type": "linear",
      "domain": [-3.0, 7.0]
    }
  },
  "envelopes": [
    {
      "id": "env-pv-export-floor",
      "label": "Peak Export -1.68 kW",
      "threshold_value": -1.68,
      "type": "reference",
      "direction": "none",
      "stroke_style": "dashed",
      "stroke_color": "var(--text-secondary)"
    },
    {
      "id": "env-evening-warn",
      "label": "Peak TOU Load Watch (4.5 kW)",
      "threshold_value": 4.5,
      "type": "warning",
      "direction": "upper",
      "stroke_style": "dash-dot",
