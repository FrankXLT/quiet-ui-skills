{
  "$schema": "urn:quiet-ui:schema:v9:waveform",
  "id": "w05-v14-canfd-reflection-scope",
  "metadata": {
    "title": "CAN-FD 2 Mbps Stub Reflection & 0.35 µs Impedance Mismatch Dropout Scope",
    "description": "Time-synchronized 3-channel bench capture showing differential CAN_H − CAN_L ringing, common-mode noise spike, and ACK_DELIM frame gate across a 0.35 µs impedance mismatch null dropout bounded by cursors Tₐ and Tᵦ.",
    "rigor_level": "L3",
    "timestamp_utc": "2026-11-17T05:30:00Z"
  },
  "waveform_kind": "scope",
  "test_environment": {
    "dut_id": "CANFD-SCOPE-BENCH-05",
    "standard_id": "ISO 11898-2 / SAE J1939",
    "ambient_temperature_c": 23.5,
    "temperature_uncertainty_c": 0.3,
    "reference_clock": "OCXO-100MHz-SYNC",
    "sampling_rate_hz": 1000000000.0
  },
  "timebase": {
    "quantity": "t",
    "quantity_calculus": "Elapsed Scope Time, t / µs",
